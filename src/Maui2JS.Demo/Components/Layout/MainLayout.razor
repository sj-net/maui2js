@inherits LayoutComponentBase
@inject IJSRuntime Js;
@{
    // This must be set here as the JSRuntime cannot invoke anything outside webview context.
    if (Maui2JS.Core.Preferences.JSRuntTime == null)
        Maui2JS.Core.Preferences.JSRuntTime = Js;
}

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
